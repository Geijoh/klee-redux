{
    "name": "klee-redux",
    "version": "1.3.0",
    "description": "Unreal Engine Blueprint and Material graph visualizer for the web, forked from @mariojgt/eu-blueprint-visualizer",
    "scripts": {
        "dev": "webpack serve --config webpack.dev.js",
        "docs": "webpack serve --config webpack.docs.js",
        "pretest": "npm run build",
        "test": "node --test test/*.test.js",
        "build": "webpack --config webpack.prod.js",
        "build:site": "npm run build && node scripts/build-site.js"
    },
    "files": [
        "/dist"
    ],
    "keywords": [
        "Unreal",
        "Unreal Engine",
        "Blueprint",
        "Material",
        "NodeGraph"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Geijoh/klee-redux.git"
    },
    "author": {
        "name": "Chris Johnson",
        "url": "https://www.kris-j.com"
    },
    "contributors": [
        {
            "email": "mariojgt2@gmail.com",
            "name": "Mario Tarosso",
            "url": "https://thedevrealm.com"
        }
    ],
    "devDependencies": {
        "ifdef-loader": "^2.3.2",
        "ts-loader": "^9.4.1",
        "typescript": "^4.9.3",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.0",
        "webpack-dev-server": "^4.11.1",
        "webpack-merge": "^5.8.0"
    }
}
